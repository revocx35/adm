# Names/IPs ADM's self-signed certificate must cover: the address the agent machine uses (Settings -> Agent).
ADM_TLS_NAMES=adm.lan,192.168.1.30
# ADM_HTTPS_PORT=8450
# ADM_INTERNAL_PORT=8451  # loopback-only listener inside the container for ADM's SSH tunnels
# ADM_SETUP_CODE=          # fixed first-run code; default: random, printed in the log
# ADM_TRUSTED_PROXIES=     # reverse proxies whose X-Forwarded-For is trusted (CIDRs)
# ADM_TLS_CERT= / ADM_TLS_KEY=   # your own certificate (PEM paths inside the container)
# ADM_MAX_UPLOAD_GB=200
# Host folders mounted into /libraries/... (see docker-compose.yml)
ADM_MOVIES_HOST=/mnt/media/movies
ADM_SHOWS_HOST=/mnt/media/tv
ADM_BOOKS_HOST=/srv/books/library
ADM_STAGING_HOST=./staging
